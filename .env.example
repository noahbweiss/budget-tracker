# Copy this file to .env and adjust as needed. This is optional — a
# sensible default is baked into app/config.py, so an empty .env (or no
# .env at all outside Docker) works fine for local/manual use.

# SQLAlchemy connection string. Defaults to a local SQLite file under data/.
DATABASE_URL=sqlite:///./data/finance.db

# SimpleFin's access URL is not an env var — it's entered once through the
# app's "Connect a bank" page (paste a setup token there) and stored in
# data/finance.db's simplefin_connections table, not here. No env var
# needed for it.
