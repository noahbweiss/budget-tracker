# Copy this file to .env and adjust as needed. Both variables are optional —
# sensible defaults are baked into app/config.py, so an empty .env (or no
# .env at all outside Docker) works fine for local/manual use.

# SQLAlchemy connection string. Defaults to a local SQLite file under data/.
DATABASE_URL=sqlite:///./data/finance.db

# SimpleFin access URL, obtained by exchanging a SimpleFin setup token
# (see README's "Connecting a bank" section). Leave unset until you've
# connected a bank — manual/CSV-only use never needs this.
# NOTE: storage location for this is expected to change (see CLAUDE.md,
# "Open decision" in the Data model section) — this env var may move to a
# per-account DB record in a later phase.
SIMPLEFIN_ACCESS_URL=
